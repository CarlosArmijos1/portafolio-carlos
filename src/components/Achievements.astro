---
import { achievements } from "../data/site";
import SectionHeading from "./SectionHeading.astro";
---

<section id="achievements" class="py-20 px-4">
  <div class="mx-auto max-w-4xl">
    <SectionHeading title="Logros" subtitle="Hitos académicos y profesionales destacados." />

    <ul class="grid sm:grid-cols-2 gap-4">
      {achievements.map((a) => (
        <li class="flex gap-3 p-5 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-primary)]/40 transition-colors">
          <span class="shrink-0 size-9 rounded-full bg-[var(--color-primary)]/10 flex items-center justify-center">
            <svg class="size-4 text-[var(--color-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 7 7 .5-5.5 4.5L18 21l-6-3.5L6 21l1.5-7L2 9.5 9 9z"/></svg>
          </span>
          <p class="text-sm text-[var(--color-foreground)] pt-1.5 leading-relaxed">{a}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
