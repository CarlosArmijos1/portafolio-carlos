---
import { experience } from "../data/site";
import SectionHeading from "./SectionHeading.astro";
---

<section id="experience" class="py-20 px-4">
  <div class="mx-auto max-w-4xl">
    <SectionHeading title="Trayectoria" subtitle="Roles y proyectos donde he participado." />

    <ol class="relative border-l-2 border-[var(--color-border)] ml-3 space-y-10">
      {experience.map((e) => (
        <li class="ml-8">
          <span class="absolute -left-[9px] size-4 rounded-full bg-[var(--color-primary)] ring-4 ring-[var(--color-background)]"></span>
          <div class="rounded-xl border border-[var(--color-border)] p-6 hover:border-[var(--color-primary)]/40 transition-colors">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h3 class="font-serif text-xl font-semibold">{e.role}</h3>
              <span class="text-[var(--color-primary)]">@</span>
              <span class="text-[var(--color-muted-foreground)]">{e.company}</span>
            </div>
            <p class="text-xs font-mono text-[var(--color-muted-foreground)] mt-1">{e.period}</p>
            <p class="mt-4 text-[var(--color-muted-foreground)]">{e.summary}</p>
            {e.bullets.length > 0 && (
              <ul class="mt-3 space-y-1.5 text-sm text-[var(--color-muted-foreground)] list-disc pl-5">
                {e.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
