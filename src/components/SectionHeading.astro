---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
}
const { eyebrow, title, subtitle, align = "center" } = Astro.props;
const wrap = align === "center" ? "text-center" : "text-left";
const inlineUnderline = align === "center" ? "mx-auto" : "mx-0";
---

<header class={`mb-12 ${wrap}`}>
  {eyebrow && (
    <p class="text-sm font-mono text-[var(--color-primary)] mb-2">{eyebrow}</p>
  )}
  <div class="inline-block">
    <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight">
      {title}
    </h2>
    <span class={`block h-[3px] bg-[var(--color-primary)] mt-2 w-2/3 ${inlineUnderline}`}></span>
  </div>
  {subtitle && (
    <p class={`mt-5 text-[var(--color-muted-foreground)] max-w-2xl ${align === "center" ? "mx-auto" : ""}`}>
      {subtitle}
    </p>
  )}
</header>
