---
import { site } from "../data/site";
import SectionHeading from "./SectionHeading.astro";
---

<section id="contact" class="py-24 px-4">
  <div class="mx-auto max-w-5xl">
    <SectionHeading
      title="Hablemos"
      subtitle="¿Tienes una idea, un proyecto o una colaboración en mente? Escríbeme."
    />

    <div class="grid lg:grid-cols-[1fr_1.2fr] gap-8">
      <aside class="space-y-4">
        <h3 class="font-serif text-xl font-semibold mb-2">Información de contacto</h3>
        <p class="text-sm text-[var(--color-muted-foreground)]">
          Estoy abierto a oportunidades de freelance, colaboraciones y conversaciones sobre tecnología.
        </p>

        <a href={`mailto:${site.email}`} class="flex items-center gap-4 p-4 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-primary)]/40 transition-colors group">
          <span class="size-10 rounded-lg bg-[var(--color-primary)]/10 flex items-center justify-center shrink-0">
            <svg class="size-5 text-[var(--color-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </span>
          <div class="min-w-0">
            <p class="text-xs font-mono text-[var(--color-muted-foreground)]">Email</p>
            <p class="text-sm font-medium truncate group-hover:text-[var(--color-primary)] transition-colors">{site.email}</p>
          </div>
        </a>

        <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="flex items-center gap-4 p-4 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-primary)]/40 transition-colors group">
          <span class="size-10 rounded-lg bg-[var(--color-primary)]/10 flex items-center justify-center shrink-0">
            <svg class="size-5 text-[var(--color-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          <div class="min-w-0">
            <p class="text-xs font-mono text-[var(--color-muted-foreground)]">Teléfono</p>
            <p class="text-sm font-medium group-hover:text-[var(--color-primary)] transition-colors">{site.phone}</p>
          </div>
        </a>

        <a href={site.whatsapp} target="_blank" rel="noopener" class="flex items-center gap-4 p-4 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-primary)]/40 transition-colors group">
          <span class="size-10 rounded-lg bg-[var(--color-primary)]/10 flex items-center justify-center shrink-0">
            <svg class="size-5 text-[var(--color-primary)]" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.465 3.488"/></svg>
          </span>
          <div class="min-w-0">
            <p class="text-xs font-mono text-[var(--color-muted-foreground)]">WhatsApp</p>
            <p class="text-sm font-medium group-hover:text-[var(--color-primary)] transition-colors">Iniciar chat</p>
          </div>
        </a>

        <div class="flex items-center gap-4 p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-muted)]/40">
          <span class="size-10 rounded-lg bg-[var(--color-primary)]/10 flex items-center justify-center shrink-0">
            <span class="relative flex size-2.5">
              <span class="absolute inline-flex h-full w-full rounded-full bg-[var(--color-primary)] opacity-75 animate-ping"></span>
              <span class="relative inline-flex size-2.5 rounded-full bg-[var(--color-primary)]"></span>
            </span>
          </span>
          <div class="min-w-0">
            <p class="text-xs font-mono text-[var(--color-primary)]">Tiempo de respuesta</p>
            <p class="text-sm text-[var(--color-muted-foreground)]">Normalmente respondo en menos de 24h.</p>
          </div>
        </div>
      </aside>

      <form
        action={`mailto:${site.email}`}
        method="post"
        enctype="text/plain"
        class="space-y-4 p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-background)]/50"
      >
        <h3 class="font-serif text-xl font-semibold">Envíame un mensaje</h3>
        <p class="text-sm text-[var(--color-muted-foreground)]">
          Completa el formulario y se abrirá tu cliente de email con el mensaje listo para enviar.
        </p>

        <label class="block">
          <span class="text-xs font-mono text-[var(--color-muted-foreground)]">Nombre</span>
          <input
            type="text"
            name="name"
            placeholder="Tu nombre"
            required
            class="mt-1 w-full rounded-md border border-[var(--color-border)] bg-[var(--color-background)] px-3 py-2.5 text-sm placeholder:text-[var(--color-muted-foreground)]/60 focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/40 focus:border-[var(--color-primary)]"
          />
        </label>
        <label class="block">
          <span class="text-xs font-mono text-[var(--color-muted-foreground)]">Email</span>
          <input
            type="email"
            name="email"
            placeholder="tu@email.com"
            required
            class="mt-1 w-full rounded-md border border-[var(--color-border)] bg-[var(--color-background)] px-3 py-2.5 text-sm placeholder:text-[var(--color-muted-foreground)]/60 focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/40 focus:border-[var(--color-primary)]"
          />
        </label>
        <label class="block">
          <span class="text-xs font-mono text-[var(--color-muted-foreground)]">Mensaje</span>
          <textarea
            name="message"
            rows="5"
            placeholder="Cuéntame sobre tu proyecto..."
            required
            class="mt-1 w-full rounded-md border border-[var(--color-border)] bg-[var(--color-background)] px-3 py-2.5 text-sm placeholder:text-[var(--color-muted-foreground)]/60 focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/40 focus:border-[var(--color-primary)] resize-y"
          ></textarea>
        </label>
        <button
          type="submit"
          class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-md bg-[var(--color-primary)] text-white font-medium hover:opacity-90 transition-opacity"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
          Enviar mensaje
        </button>
      </form>
    </div>
  </div>
</section>

<footer class="py-8 px-4 border-t border-[var(--color-border)] text-center text-sm text-[var(--color-muted-foreground)]">
  © {new Date().getFullYear()} {site.fullName}. Hecho con Astro y Tailwind.
</footer>
