---
import { projects } from "../data/site";
import SectionHeading from "./SectionHeading.astro";
---

<section id="projects" class="py-20 px-4">
  <div class="mx-auto max-w-6xl">
    <SectionHeading
      title="Proyectos seleccionados"
      subtitle="Una muestra de proyectos en web full-stack y visión por computador."
    />

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((p) => (
        <article class="group flex flex-col rounded-xl border border-[var(--color-border)] overflow-hidden hover:border-[var(--color-primary)]/40 hover:-translate-y-1 transition-all duration-300 bg-[var(--color-background)]/40">
          <div class="relative aspect-video bg-gradient-to-br from-[var(--color-primary)]/10 via-[var(--color-muted)] to-[var(--color-muted)] flex items-center justify-center overflow-hidden">
            {p.featured && (
              <span class="absolute top-3 right-3 text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-[var(--color-primary)] text-white">
                Featured
              </span>
            )}
            <svg class="size-16 text-[var(--color-primary)]/30 group-hover:text-[var(--color-primary)]/60 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
            </svg>
          </div>

          <div class="p-5 flex flex-col gap-3 flex-1">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-serif text-lg font-semibold group-hover:text-[var(--color-primary)] transition-colors">
                {p.title}
              </h3>
              <span class="text-xs font-mono text-[var(--color-muted-foreground)] shrink-0">{p.year}</span>
            </div>

            <ul class="flex flex-wrap gap-1.5">
              {p.tags.map((t) => (
                <li class="text-[11px] font-mono px-2 py-0.5 rounded bg-[var(--color-muted)] text-[var(--color-foreground)]">{t}</li>
              ))}
            </ul>

            <p class="text-sm text-[var(--color-muted-foreground)]">{p.description}</p>

            <div class="mt-auto pt-2">
              <a
                href={p.href}
                class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-md bg-[var(--color-primary)] text-white text-sm font-medium hover:opacity-90 transition-opacity"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                Live Demo
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
