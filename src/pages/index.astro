---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import SkillsMarquee from "../components/SkillsMarquee.astro";
import Skills from "../components/Skills.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Achievements from "../components/Achievements.astro";
import Contact from "../components/Contact.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <SkillsMarquee />
    <div data-reveal><Skills /></div>
    <div data-reveal><Experience /></div>
    <div data-reveal><Projects /></div>
    <div data-reveal><Achievements /></div>
    <div data-reveal><Contact /></div>
  </main>
  <ScrollToTop />
  <ScrollReveal />
</Layout>
